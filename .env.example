# Copy to .env.local. Everything is optional for local use.

# Database. Leave unset to use a local file at data/radar.db.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Dashboard password. Leave unset to run without a lock (local only).
DASH_PASSWORD=

# Secret that AI clients must send to /api/mcp. Required once deployed.
MCP_TOKEN=

# Claude API key for the idea chat, AI tagging and choke-point checks (optional).
ANTHROPIC_API_KEY=
